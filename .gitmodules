[submodule "lib/forge-std"]
	path = lib/forge-std
	url = https://github.com/foundry-rs/forge-std
	branch = v1
[submodule "lib/solady"]
	path = lib/solady
	url = https://github.com/vectorized/solady
	branch = main
[submodule "lib/openzeppelin-foundry-upgrades"]
	path = lib/openzeppelin-foundry-upgrades
	url = https://github.com/OpenZeppelin/openzeppelin-foundry-upgrades
	branch = main
[submodule "lib/openzeppelin-contracts"]
	path = lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
	branch = v5.1.0
[submodule "lib/openzeppelin-contracts-upgradeable"]
	path = lib/openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
	branch = v5.1.0
[submodule "lib/uniswap-v4-periphery"]
	path = lib/uniswap-v4-periphery
	url = https://github.com/Uniswap/v4-periphery.git
	branch = main
[submodule "lib/evm-m-extensions"]
	path = lib/evm-m-extensions
	url = https://github.com/m0-foundation/evm-m-extensions.git
	branch = linea-deployment
[submodule "lib/m-portal"]
	path = lib/m-portal
	url = https://github.com/m0-foundation/m-portal
	branch = main
