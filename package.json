{
  "name": "@startale/stablecoin-contracts",
  "version": "1.0.0",
  "description": "Startale stablecoin and related contracts",
  "main": "index.js",
  "author": "Startale Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StartaleGroup/stablecoin-contracts.git"
  },
  "bugs": {
    "url": "https://github.com/StartaleGroup/stablecoin-contracts/issues"
  },
  "homepage": "https://github.com/StartaleGroup/stablecoin-contracts/#readme",
  "scripts": {
    "build": "make -B build",
    "clean": "make -B clean",
    "compile": "forge compile",
    "coverage": "make -B coverage",
    "deploy-local": "make -B deploy-local",
    "deploy-sepolia": "make -B deploy-sepolia",
    "doc": "forge doc --serve --port 4000",
    "lint-staged": "lint-staged",
    "prepack": "yarn run clean && yarn run build",
    "prepare": "husky",
    "prettier": "prettier --write 'script/**/*.sol' 'src/**/*.sol' 'test/**/*.sol'",
    "slither": "forge build --build-info --skip '*/test/**' --skip '*/script/**' --force && slither --compile-force-framework foundry --ignore-compile --config-file slither.config.json --fail-high .",
    "solhint": "solhint -f stylish 'src/**/*.sol'",
    "solhint-fix": "solhint --fix 'src/**/*.sol'",
    "test": "make -B tests",
    "test-gas": "make -B gas-report",
    "test-fuzz": "make -B fuzz",
    "test-integration": "make -B integration",
    "test-invariant": "make -B invariant"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.1.0",
    "solhint": "^6.0.0",
    "solhint-plugin-prettier": "^0.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/**",
    "out/**"
  ]
}
